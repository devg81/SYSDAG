{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devg81/SYSDAG/schemas/patient_schema.json",
  "title": "SYSDAG Synthetic Cardiovascular Patient Record",
  "description": "Schema of every synthetic patient record generated in this project (schema versions 0.7 to 0.13; current 0.13). Machine-readable mirror of schemas/patient_schema.py. Fields marked 'Added in vX' are absent from records older than vX. Empty-value convention: null = not modelled by the generator; [] = modelled, nothing applies. ALL RECORDS ARE SYNTHETIC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patient_id",
    "demographics",
    "provenance",
    "risk_factors",
    "family_history",
    "medical_history",
    "diagnoses",
    "medications",
    "labs",
    "lipid_panel",
    "lipid_interpretations",
    "ecg",
    "echo",
    "clinical_timeline",
    "validation"
  ],
  "properties": {
    "patient_id": {
      "type": "string",
      "pattern": "^PAT_[0-9]{6}$",
      "description": "Synthetic patient identifier. Never a real patient ID."
    },
    "demographics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["age", "sex", "height_cm", "weight_kg", "state", "urban_rural"],
      "properties": {
        "age": { "type": "number", "minimum": 20, "maximum": 90, "description": "Age in years, uniform 20-89 (2 decimals from v0.10)." },
        "sex": { "type": "integer", "enum": [0, 1], "description": "PTB-XL encoding: 0 = male, 1 = female." },
        "height_cm": { "type": ["number", "null"], "description": "cm. Not modelled (always null)." },
        "weight_kg": { "type": ["number", "null"], "description": "kg. Not modelled (always null)." },
        "state": { "type": ["string", "null"], "description": "Indian state / union territory." },
        "urban_rural": { "type": ["string", "null"], "enum": ["urban", "rural", null] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "generated_at", "generator", "random_seed", "source_datasets"],
      "properties": {
        "schema_version": { "type": "string", "enum": ["0.7", "0.8", "0.9", "0.10", "0.11", "0.12", "0.13"] },
        "generated_at": { "type": "string", "format": "date-time", "description": "UTC timestamp of generation." },
        "generator": { "type": "string", "description": "Free-text description of how every field was generated." },
        "random_seed": { "type": "integer", "description": "Seed that reproduces this record." },
        "source_datasets": { "type": "array", "items": { "type": "string" }, "description": "Datasets that influenced generation." }
      }
    },
    "risk_factors": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["bmi", "smoking_status", "hypertension", "diabetes", "hyperlipidemia"],
      "properties": {
        "bmi": { "type": ["number", "null"], "description": "Body-mass index, kg/m^2." },
        "smoking_status": { "type": ["string", "null"], "enum": ["never", "former", "current", null] },
        "hypertension": { "type": ["boolean", "null"], "description": "Sampled; v0.13 from age x sex prevalence curve." },
        "diabetes": { "type": ["boolean", "null"], "description": "Sampled; v0.13 from age prevalence curve." },
        "hyperlipidemia": { "type": ["boolean", "null"], "description": "v0.11+: derived from the NCEP_ATP_III lipid interpretation." }
      }
    },
    "family_history": {
      "description": "null before v0.9 (not modelled). Added (populated) in v0.9.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["diabetes", "cardiovascular_disease", "derivation"],
          "properties": {
            "diabetes": { "type": "boolean", "description": "Diabetes in a first-degree relative." },
            "cardiovascular_disease": { "type": "boolean", "description": "Heart disease or stroke in a first-degree relative." },
            "derivation": { "type": "string", "enum": ["lasi_observed_45_plus", "parent_simulation_calibrated"] }
          }
        }
      ]
    },
    "medical_history": {
      "type": ["array", "null"],
      "items": { "$ref": "#/$defs/MedicalHistoryEntry" }
    },
    "diagnoses": {
      "type": ["array", "null"],
      "items": { "$ref": "#/$defs/Diagnosis" }
    },
    "medications": {
      "type": ["array", "null"],
      "items": { "$ref": "#/$defs/Medication" }
    },
    "labs": {
      "type": ["array", "null"],
      "description": "v0.10+: always a list with HbA1c. Before v0.10, null for diabetics.",
      "items": { "$ref": "#/$defs/Lab" }
    },
    "blood_pressure": {
      "description": "Added in v0.8.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/BloodPressure" }]
    },
    "air_quality": {
      "description": "Added in v0.9. State-level annual AQI lookup, not personal exposure.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/AirQuality" }]
    },
    "encounters": {
      "type": ["array", "null"],
      "description": "Added (populated) in v0.8; null in v0.7.",
      "items": { "$ref": "#/$defs/Encounter" }
    },
    "lipid_panel": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/LipidPanel" }]
    },
    "lipid_interpretations": {
      "type": ["array", "null"],
      "items": { "$ref": "#/$defs/LipidInterpretation" }
    },
    "ecg": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/ECGRecord" }]
    },
    "echo": {
      "type": ["object", "null"],
      "description": "Not modelled (always null)."
    },
    "clinical_timeline": {
      "type": "array",
      "items": { "$ref": "#/$defs/TimelineEvent" }
    },
    "validation": { "$ref": "#/$defs/ValidationMetadata" }
  },

  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "nullableDate": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "confidence": { "type": ["string", "null"], "enum": ["moderate", "low", null] },

    "MedicalHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "description", "diagnosis_id", "event_date"],
      "properties": {
        "category": { "type": "string", "enum": ["diagnosis", "cv_event", "procedure", "chronic_condition"], "description": "Only chronic_condition is generated." },
        "description": { "type": "string", "description": "Mirrors the referenced Diagnosis.code." },
        "diagnosis_id": { "type": ["string", "null"], "pattern": "^PAT_[0-9]{6}_DX[0-9]{2}$" },
        "event_date": { "$ref": "#/$defs/nullableDate", "description": "Not modelled (always null)." }
      }
    },

    "Diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnosis_id", "code", "diagnosed_date", "source"],
      "properties": {
        "diagnosis_id": { "type": "string", "pattern": "^PAT_[0-9]{6}_DX[0-9]{2}$" },
        "code": { "type": "string", "enum": ["hypertension", "diabetes"], "description": "1:1 promotion of the risk_factors flag." },
        "diagnosed_date": { "$ref": "#/$defs/nullableDate", "description": "Not modelled (always null)." },
        "source": { "type": "string", "const": "derived_from_risk_factors" },
        "age_at_onset_years": { "type": ["number", "null"], "minimum": 0, "description": "Added in v0.10. Modelled onset age, always <= current age." },
        "onset_date": { "$ref": "#/$defs/nullableDate", "description": "Added in v0.10." },
        "onset_derivation": { "type": ["string", "null"], "pattern": "^modeled_", "description": "Added in v0.10." },
        "onset_confidence": { "$ref": "#/$defs/confidence", "description": "Added in v0.10." }
      }
    },

    "Medication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["medication_id", "drug_class", "diagnosis_id", "current_status", "start_date", "stop_date", "source"],
      "properties": {
        "medication_id": { "type": "string", "pattern": "^PAT_[0-9]{6}_MED[0-9]{2}$" },
        "drug_class": { "type": "string", "enum": ["antihypertensive", "antidiabetic"], "description": "Class only, no drug names." },
        "diagnosis_id": { "type": "string", "pattern": "^PAT_[0-9]{6}_DX[0-9]{2}$" },
        "current_status": { "type": "string", "enum": ["active", "discontinued"], "description": "Only active is generated." },
        "start_date": { "$ref": "#/$defs/nullableDate", "description": "Not modelled (always null)." },
        "stop_date": { "$ref": "#/$defs/nullableDate", "description": "Not modelled (always null)." },
        "source": { "type": "string", "const": "derived_from_diagnosis_treatment_rate" }
      }
    },

    "Lab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyte", "unit", "value", "measured_at"],
      "properties": {
        "analyte": { "type": "string", "enum": ["HbA1c", "LDL", "HDL", "triglycerides", "total_cholesterol"], "description": "Only HbA1c is generated as a lab entry." },
        "unit": { "type": "string", "enum": ["%", "mg/dL"] },
        "value": { "type": ["number", "null"] },
        "measured_at": { "$ref": "#/$defs/nullableDate" },
        "derivation": { "type": ["string", "null"], "description": "Added in v0.10. Distribution that produced the value." },
        "confidence": { "$ref": "#/$defs/confidence", "description": "Added in v0.10." }
      }
    },

    "BloodPressure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systolic_mm_hg", "diastolic_mm_hg", "measured_at", "age_band_source", "extrapolated_beyond_source_age_range", "source"],
      "properties": {
        "systolic_mm_hg": { "type": ["integer", "null"], "description": "mmHg." },
        "diastolic_mm_hg": { "type": ["integer", "null"], "description": "mmHg." },
        "measured_at": { "$ref": "#/$defs/nullableDate" },
        "age_band_source": { "type": ["string", "null"], "description": "NFHS-5 age band used, or the extrapolation note." },
        "extrapolated_beyond_source_age_range": { "type": ["boolean", "null"] },
        "source": { "type": "string", "const": "derived_conditional_on_hypertension_label" },
        "confidence": { "$ref": "#/$defs/confidence", "description": "Added in v0.10." }
      }
    },

    "AirQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aqi", "category", "reference_year", "stations", "cities", "unavailable_reason", "geographic_resolution", "monitoring_bias", "source"],
      "properties": {
        "aqi": { "type": ["number", "null"], "description": "2023 CPCB annual mean AQI of the patient's state; null if unavailable." },
        "category": { "type": ["string", "null"], "enum": ["Good", "Satisfactory", "Moderate", "Poor", "Very Poor", "Severe", null] },
        "reference_year": { "type": ["integer", "null"] },
        "stations": { "type": ["integer", "null"] },
        "cities": { "type": ["integer", "null"] },
        "unavailable_reason": { "type": ["string", "null"] },
        "geographic_resolution": { "type": "string", "const": "state" },
        "monitoring_bias": { "type": "string", "const": "state_mean_is_urban_station_weighted" },
        "source": { "type": "string" }
      }
    },

    "Encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encounter_id", "encounter_type", "date", "patient_id", "recorded_measurements", "source"],
      "properties": {
        "encounter_id": { "type": "string", "pattern": "^PAT_[0-9]{6}_ENC[0-9]{2}$" },
        "encounter_type": { "type": "string", "enum": ["synthetic_baseline_assessment"], "description": "Structural container, not a real healthcare visit." },
        "date": { "$ref": "#/$defs/date" },
        "patient_id": { "type": "string", "pattern": "^PAT_[0-9]{6}$" },
        "recorded_measurements": { "type": "array", "items": { "type": "string", "enum": ["blood_pressure", "lipid_panel", "labs.HbA1c"] } },
        "source": { "type": "string", "const": "synthetic_structural_container" }
      }
    },

    "LipidPanel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ldl_mg_dl", "hdl_mg_dl", "triglycerides_mg_dl", "total_cholesterol_mg_dl"],
      "properties": {
        "ldl_mg_dl": { "type": ["number", "null"], "description": "mg/dL. Derived via Friedewald." },
        "hdl_mg_dl": { "type": ["number", "null"], "description": "mg/dL." },
        "triglycerides_mg_dl": { "type": ["number", "null"], "description": "mg/dL." },
        "total_cholesterol_mg_dl": { "type": ["number", "null"], "description": "mg/dL." }
      }
    },

    "LipidInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "dyslipidemia", "components_abnormal", "source_citation"],
      "properties": {
        "definition": { "type": "string", "description": "Guideline key, e.g. NCEP_ATP_III or LAI_2020 (open vocabulary)." },
        "dyslipidemia": { "type": ["boolean", "null"] },
        "components_abnormal": { "type": "array", "items": { "type": "string", "enum": ["LDL", "HDL", "triglycerides", "total_cholesterol"] } },
        "source_citation": { "type": ["string", "null"] },
        "risk_category": { "type": ["string", "null"], "enum": ["low", "moderate", "high", "very_high", null], "description": "Added in v0.12. LAI_2020 only; null otherwise." },
        "ldl_goal_mg_dl": { "type": ["number", "null"], "description": "Added in v0.12. mg/dL." },
        "ldl_above_goal": { "type": ["boolean", "null"], "description": "Added in v0.12." },
        "risk_factors_counted": { "type": ["array", "null"], "items": { "type": "string", "enum": ["age", "current_smoking", "hypertension", "low_hdl", "diabetes"] }, "description": "Added in v0.12." },
        "risk_derivation": { "type": ["string", "null"], "description": "Added in v0.12." }
      }
    },

    "ECGRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "ecg_id", "superclasses", "strat_fold", "sampling_hz", "signal_shape", "filename", "signal_available"],
      "properties": {
        "source": { "type": "string", "const": "PTB-XL" },
        "ecg_id": { "type": "integer", "description": "PTB-XL ecg_id (metadata link only)." },
        "superclasses": { "type": "array", "items": { "type": "string", "enum": ["NORM", "MI", "STTC", "CD", "HYP"] } },
        "strat_fold": { "type": "integer", "minimum": 1, "maximum": 10 },
        "sampling_hz": { "type": "integer", "enum": [100, 500] },
        "signal_shape": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2, "description": "[samples, leads]" },
        "filename": { "type": "string" },
        "signal_available": { "type": "boolean", "description": "false: no waveform attached yet." }
      }
    },

    "TimelineEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_type", "date"],
      "properties": {
        "event_type": { "type": "string", "enum": ["synthetic_record_created", "synthetic_baseline_assessment", "condition_onset_modeled"] },
        "date": { "$ref": "#/$defs/date" },
        "reference_id": { "type": ["string", "null"], "description": "Added in v0.8. Encounter or Diagnosis id this event indexes." }
      }
    },

    "ValidationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validated", "validation_version", "errors"],
      "properties": {
        "validated": { "type": "boolean" },
        "validation_version": { "type": ["string", "null"] },
        "errors": { "type": "array", "items": { "type": "string" } },
        "clinical_consistency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid", "errors", "warnings"],
          "description": "Added in v0.10 (stored in record).",
          "properties": {
            "valid": { "type": "boolean" },
            "errors": { "type": "array", "items": { "type": "string" } },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
