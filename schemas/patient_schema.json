{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devg81/SYSDAG/schemas/patient_schema.json",
  "title": "SYSDAG Synthetic Cardiovascular Patient Record",
  "description": "Schema of every synthetic patient record generated in this project (schema versions 0.7 to 0.13; current 0.13). Machine-readable mirror of schemas/patient_schema.py. Fields marked 'Added in vX' are absent from records older than vX. Empty-value convention: null = not modelled by the generator; [] = modelled, nothing applies. ALL RECORDS ARE SYNTHETIC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patient_id",
    "demographics",
    "provenance",
    "risk_factors",
    "family_history",
    "medical_history",
    "diagnoses",
    "medications",
    "labs",
    "lipid_panel",
    "lipid_interpretations",
    "ecg",
    "echo",
    "clinical_timeline",
    "validation"
  ],
  "properties": {
    "patient_id": {
      "type": "string",
      "pattern": "^PAT_[0-9]{6}$",
      "description": "Synthetic patient identifier. Never a real patient ID."
    },
    "demographics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "age",
        "sex",
        "height_cm",
        "weight_kg",
        "state",
        "urban_rural"
      ],
      "properties": {
        "age": {
          "type": "number",
          "minimum": 20,
          "maximum": 90,
          "description": "Age in years, uniform 20-89 (2 decimals from v0.10)."
        },
        "sex": {
          "type": "integer",
          "enum": [
            0,
            1
          ],
          "description": "PTB-XL encoding: 0 = male, 1 = female."
        },
        "height_cm": {
          "type": [
            "number",
            "null"
          ],
          "description": "cm. Not modelled (always null)."
        },
        "weight_kg": {
          "type": [
            "number",
            "null"
          ],
          "description": "kg. Not modelled (always null)."
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "description": "Indian state / union territory."
        },
        "urban_rural": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "urban",
            "rural",
            null
          ],
          "description": "Urban or rural residence (Census 2011 urban share of the state)."
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generated_at",
        "generator",
        "random_seed",
        "source_datasets"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "0.7",
            "0.8",
            "0.9",
            "0.10",
            "0.11",
            "0.12",
            "0.13"
          ],
          "description": "Schema version the record was generated or migrated at."
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC timestamp of generation."
        },
        "generator": {
          "type": "string",
          "description": "Free-text description of how every field was generated."
        },
        "random_seed": {
          "type": "integer",
          "description": "Seed that reproduces this record."
        },
        "source_datasets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Datasets that influenced generation."
        }
      }
    },
    "risk_factors": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "bmi",
        "smoking_status",
        "hypertension",
        "diabetes",
        "hyperlipidemia"
      ],
      "properties": {
        "bmi": {
          "type": [
            "number",
            "null"
          ],
          "description": "Body-mass index, kg/m^2."
        },
        "smoking_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "never",
            "former",
            "current",
            null
          ],
          "description": "Smoking status, drawn by sex (former is allowed but not generated)."
        },
        "hypertension": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Sampled; v0.13 from age x sex prevalence curve."
        },
        "diabetes": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Sampled; v0.13 from age prevalence curve."
        },
        "hyperlipidemia": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "v0.11+: derived from the NCEP_ATP_III lipid interpretation."
        }
      }
    },
    "family_history": {
      "description": "null before v0.9 (not modelled). Added (populated) in v0.9.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "diabetes",
            "cardiovascular_disease",
            "derivation"
          ],
          "properties": {
            "diabetes": {
              "type": "boolean",
              "description": "Diabetes in a first-degree relative."
            },
            "cardiovascular_disease": {
              "type": "boolean",
              "description": "Heart disease or stroke in a first-degree relative."
            },
            "derivation": {
              "type": "string",
              "enum": [
                "lasi_observed_45_plus",
                "parent_simulation_calibrated"
              ],
              "description": "LASI observed rate (age 45+) or modelled from parents (age 20-44)."
            }
          }
        }
      ]
    },
    "medical_history": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/MedicalHistoryEntry"
      }
    },
    "diagnoses": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Diagnosis"
      }
    },
    "medications": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Medication"
      }
    },
    "labs": {
      "type": [
        "array",
        "null"
      ],
      "description": "v0.10+: always a list with HbA1c. Before v0.10, null for diabetics.",
      "items": {
        "$ref": "#/$defs/Lab"
      }
    },
    "blood_pressure": {
      "description": "Added in v0.8.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/BloodPressure"
        }
      ]
    },
    "air_quality": {
      "description": "Added in v0.9. State-level annual AQI lookup, not personal exposure.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/AirQuality"
        }
      ]
    },
    "encounters": {
      "type": [
        "array",
        "null"
      ],
      "description": "Added (populated) in v0.8; null in v0.7.",
      "items": {
        "$ref": "#/$defs/Encounter"
      }
    },
    "lipid_panel": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/LipidPanel"
        }
      ]
    },
    "lipid_interpretations": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/LipidInterpretation"
      }
    },
    "ecg": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/ECGRecord"
        }
      ]
    },
    "echo": {
      "type": [
        "object",
        "null"
      ],
      "description": "Not modelled (always null)."
    },
    "clinical_timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TimelineEvent"
      }
    },
    "validation": {
      "$ref": "#/$defs/ValidationMetadata"
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "nullableDate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "confidence": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "moderate",
        "low",
        null
      ]
    },
    "MedicalHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "description",
        "diagnosis_id",
        "event_date"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "diagnosis",
            "cv_event",
            "procedure",
            "chronic_condition"
          ],
          "description": "Only chronic_condition is generated."
        },
        "description": {
          "type": "string",
          "description": "Mirrors the referenced Diagnosis.code."
        },
        "diagnosis_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^PAT_[0-9]{6}_DX[0-9]{2}$",
          "description": "The diagnosis this entry refers to."
        },
        "event_date": {
          "$ref": "#/$defs/nullableDate",
          "description": "Not modelled (always null)."
        }
      }
    },
    "Diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnosis_id",
        "code",
        "diagnosed_date",
        "source"
      ],
      "properties": {
        "diagnosis_id": {
          "type": "string",
          "pattern": "^PAT_[0-9]{6}_DX[0-9]{2}$",
          "description": "Unique diagnosis ID within the record."
        },
        "code": {
          "type": "string",
          "enum": [
            "hypertension",
            "diabetes"
          ],
          "description": "1:1 promotion of the risk_factors flag."
        },
        "diagnosed_date": {
          "$ref": "#/$defs/nullableDate",
          "description": "Not modelled (always null)."
        },
        "source": {
          "type": "string",
          "const": "derived_from_risk_factors",
          "description": "Diagnosis is copied from the risk-factor flag, not sampled separately."
        },
        "age_at_onset_years": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Added in v0.10. Modelled onset age, always <= current age."
        },
        "onset_date": {
          "$ref": "#/$defs/nullableDate",
          "description": "Added in v0.10. Modelled onset date (assessment date minus years since onset)."
        },
        "onset_derivation": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^modeled_",
          "description": "Added in v0.10. Which prevalence curve the onset was modelled from."
        },
        "onset_confidence": {
          "$ref": "#/$defs/confidence",
          "description": "Added in v0.10. Always low: onset is modelled, not observed."
        }
      }
    },
    "Medication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "medication_id",
        "drug_class",
        "diagnosis_id",
        "current_status",
        "start_date",
        "stop_date",
        "source"
      ],
      "properties": {
        "medication_id": {
          "type": "string",
          "pattern": "^PAT_[0-9]{6}_MED[0-9]{2}$",
          "description": "Unique medication ID within the record."
        },
        "drug_class": {
          "type": "string",
          "enum": [
            "antihypertensive",
            "antidiabetic"
          ],
          "description": "Class only, no drug names."
        },
        "diagnosis_id": {
          "type": "string",
          "pattern": "^PAT_[0-9]{6}_DX[0-9]{2}$",
          "description": "The diagnosis this medicine treats."
        },
        "current_status": {
          "type": "string",
          "enum": [
            "active",
            "discontinued"
          ],
          "description": "Only active is generated."
        },
        "start_date": {
          "$ref": "#/$defs/nullableDate",
          "description": "Not modelled (always null)."
        },
        "stop_date": {
          "$ref": "#/$defs/nullableDate",
          "description": "Not modelled (always null)."
        },
        "source": {
          "type": "string",
          "const": "derived_from_diagnosis_treatment_rate",
          "description": "Treatment drawn from ICMR-NNMS national treatment rate per diagnosis."
        }
      }
    },
    "Lab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyte",
        "unit",
        "value",
        "measured_at"
      ],
      "properties": {
        "analyte": {
          "type": "string",
          "enum": [
            "HbA1c",
            "LDL",
            "HDL",
            "triglycerides",
            "total_cholesterol"
          ],
          "description": "Only HbA1c is generated as a lab entry."
        },
        "unit": {
          "type": "string",
          "enum": [
            "%",
            "mg/dL"
          ],
          "description": "Unit of the value (HbA1c in %)."
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "description": "Measured value; HbA1c depends on diabetes status, age and sex."
        },
        "measured_at": {
          "$ref": "#/$defs/nullableDate",
          "description": "Date of the baseline assessment."
        },
        "derivation": {
          "type": [
            "string",
            "null"
          ],
          "description": "Added in v0.10. Distribution that produced the value."
        },
        "confidence": {
          "$ref": "#/$defs/confidence",
          "description": "Added in v0.10."
        }
      }
    },
    "BloodPressure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systolic_mm_hg",
        "diastolic_mm_hg",
        "measured_at",
        "age_band_source",
        "extrapolated_beyond_source_age_range",
        "source"
      ],
      "properties": {
        "systolic_mm_hg": {
          "type": [
            "integer",
            "null"
          ],
          "description": "mmHg."
        },
        "diastolic_mm_hg": {
          "type": [
            "integer",
            "null"
          ],
          "description": "mmHg."
        },
        "measured_at": {
          "$ref": "#/$defs/nullableDate",
          "description": "Date of the baseline assessment."
        },
        "age_band_source": {
          "type": [
            "string",
            "null"
          ],
          "description": "NFHS-5 age band used, or the extrapolation note."
        },
        "extrapolated_beyond_source_age_range": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "True when age is above NFHS-5 coverage (men >54, women >49)."
        },
        "source": {
          "type": "string",
          "const": "derived_conditional_on_hypertension_label",
          "description": "BP drawn consistent with the hypertension flag (never used to derive it)."
        },
        "confidence": {
          "$ref": "#/$defs/confidence",
          "description": "Added in v0.10."
        }
      }
    },
    "AirQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aqi",
        "category",
        "reference_year",
        "stations",
        "cities",
        "unavailable_reason",
        "geographic_resolution",
        "monitoring_bias",
        "source"
      ],
      "properties": {
        "aqi": {
          "type": [
            "number",
            "null"
          ],
          "description": "2023 CPCB annual mean AQI of the patient's state; null if unavailable."
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Good",
            "Satisfactory",
            "Moderate",
            "Poor",
            "Very Poor",
            "Severe",
            null
          ],
          "description": "CPCB National AQI category of the state value."
        },
        "reference_year": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Year of the AQI data (2023)."
        },
        "stations": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Monitoring stations in the state."
        },
        "cities": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Cities with monitoring stations."
        },
        "unavailable_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why AQI is missing, if it is (9 states/UTs)."
        },
        "geographic_resolution": {
          "type": "string",
          "const": "state",
          "description": "AQI is a state-level value."
        },
        "monitoring_bias": {
          "type": "string",
          "const": "state_mean_is_urban_station_weighted",
          "description": "State mean is weighted towards urban stations."
        },
        "source": {
          "type": "string",
          "description": "CPCB CAAQMS hourly AQI dataset."
        }
      }
    },
    "Encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encounter_id",
        "encounter_type",
        "date",
        "patient_id",
        "recorded_measurements",
        "source"
      ],
      "properties": {
        "encounter_id": {
          "type": "string",
          "pattern": "^PAT_[0-9]{6}_ENC[0-9]{2}$",
          "description": "Unique encounter ID within the record."
        },
        "encounter_type": {
          "type": "string",
          "enum": [
            "synthetic_baseline_assessment"
          ],
          "description": "Structural container, not a real healthcare visit."
        },
        "date": {
          "$ref": "#/$defs/date",
          "description": "Date of the baseline assessment."
        },
        "patient_id": {
          "type": "string",
          "pattern": "^PAT_[0-9]{6}$",
          "description": "Patient the encounter belongs to."
        },
        "recorded_measurements": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "blood_pressure",
              "lipid_panel",
              "labs.HbA1c"
            ]
          },
          "description": "Measurements taken at this encounter."
        },
        "source": {
          "type": "string",
          "const": "synthetic_structural_container",
          "description": "Synthetic structural container."
        }
      }
    },
    "LipidPanel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ldl_mg_dl",
        "hdl_mg_dl",
        "triglycerides_mg_dl",
        "total_cholesterol_mg_dl"
      ],
      "properties": {
        "ldl_mg_dl": {
          "type": [
            "number",
            "null"
          ],
          "description": "mg/dL. Derived via Friedewald."
        },
        "hdl_mg_dl": {
          "type": [
            "number",
            "null"
          ],
          "description": "mg/dL."
        },
        "triglycerides_mg_dl": {
          "type": [
            "number",
            "null"
          ],
          "description": "mg/dL."
        },
        "total_cholesterol_mg_dl": {
          "type": [
            "number",
            "null"
          ],
          "description": "mg/dL."
        }
      }
    },
    "LipidInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "dyslipidemia",
        "components_abnormal",
        "source_citation"
      ],
      "properties": {
        "definition": {
          "type": "string",
          "description": "Guideline key, e.g. NCEP_ATP_III or LAI_2020 (open vocabulary)."
        },
        "dyslipidemia": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Dyslipidemia verdict computed from the lipid panel."
        },
        "components_abnormal": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "LDL",
              "HDL",
              "triglycerides",
              "total_cholesterol"
            ]
          },
          "description": "Lipid values outside the guideline thresholds."
        },
        "source_citation": {
          "type": [
            "string",
            "null"
          ],
          "description": "Study / guideline the thresholds come from."
        },
        "risk_category": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "low",
            "moderate",
            "high",
            "very_high",
            null
          ],
          "description": "Added in v0.12. LAI_2020 only; null otherwise."
        },
        "ldl_goal_mg_dl": {
          "type": [
            "number",
            "null"
          ],
          "description": "Added in v0.12. LDL target for the LAI risk tier, mg/dL."
        },
        "ldl_above_goal": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Added in v0.12."
        },
        "risk_factors_counted": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "enum": [
              "age",
              "current_smoking",
              "hypertension",
              "low_hdl",
              "diabetes"
            ]
          },
          "description": "Added in v0.12."
        },
        "risk_derivation": {
          "type": [
            "string",
            "null"
          ],
          "description": "Added in v0.12."
        }
      }
    },
    "ECGRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "ecg_id",
        "superclasses",
        "strat_fold",
        "sampling_hz",
        "signal_shape",
        "filename",
        "signal_available"
      ],
      "properties": {
        "source": {
          "type": "string",
          "const": "PTB-XL",
          "description": "ECG dataset the record is linked to."
        },
        "ecg_id": {
          "type": "integer",
          "description": "PTB-XL ecg_id (metadata link only)."
        },
        "superclasses": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "NORM",
              "MI",
              "STTC",
              "CD",
              "HYP"
            ]
          },
          "description": "PTB-XL diagnostic classes: normal, myocardial infarction, ST/T change, conduction disturbance, hypertrophy."
        },
        "strat_fold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "PTB-XL stratified cross-validation fold."
        },
        "sampling_hz": {
          "type": "integer",
          "enum": [
            100,
            500
          ],
          "description": "Signal sampling rate, Hz."
        },
        "signal_shape": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[samples, leads]"
        },
        "filename": {
          "type": "string",
          "description": "PTB-XL waveform file path."
        },
        "signal_available": {
          "type": "boolean",
          "description": "false: no waveform attached yet."
        }
      }
    },
    "TimelineEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "date"
      ],
      "properties": {
        "event_type": {
          "type": "string",
          "enum": [
            "synthetic_record_created",
            "synthetic_baseline_assessment",
            "condition_onset_modeled"
          ],
          "description": "Kind of event: record created, baseline assessment, or modelled condition onset."
        },
        "date": {
          "$ref": "#/$defs/date",
          "description": "Event date."
        },
        "reference_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Added in v0.8. Encounter or Diagnosis id this event indexes."
